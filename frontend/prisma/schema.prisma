generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime?
  name           String?
  password       String
  role           Role            @default(STAFF)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  // WebAuthn passkeys registered by this user (biometric / hardware key authentication)
  // WHY: Each passkey stores the public key half of a key pair generated on the user's
  // device. The private key never leaves the secure enclave (Touch ID chip, Face ID,
  // Windows Hello TPM). Multiple passkeys are allowed (phone + laptop + security key).
  authenticators Authenticator[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  STAFF
}

model Patient {
  id         String      @id @default(cuid())
  firstName  String
  lastName   String
  dob        DateTime
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  encounters Encounter[]
  documents  Document[]
}

model Encounter {
  id          String   @id @default(cuid())
  patientId   String
  startedAt   DateTime @default(now())
  transcript  String?
  soapNote    String?
  icdCodes    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Document {
  id        String   @id @default(cuid())
  patientId String
  s3Key     String
  mimeType  String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  // Structured JSON metadata about the action (e.g., file type, role used, route).
  // WHY JSON string vs columns: audit log fields vary by action type. Storing as JSON
  // avoids a wide table with mostly-null columns while keeping data queryable.
  // No PHI is stored here — only metadata (IDs, types, sizes).
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])    // Query: "all actions by this user" (access reports)
  @@index([entity, entityId]) // Query: "all access to this patient record"
  @@index([action])    // Query: "all PHI_DELETE events"
  @@index([createdAt]) // Query: "all events in date range" (compliance reports)
}

// WebAuthn Authenticator (Passkey / Biometric Credential)
// WHY THIS TABLE: WebAuthn (FIDO2) is the W3C standard for phishing-resistant,
// passwordless authentication. When a user registers a passkey (Touch ID, Face ID,
// Windows Hello, security key), the browser generates an asymmetric key pair on
// the device. The PRIVATE key stays in the secure enclave and never leaves the device.
// The PUBLIC key is sent to our server and stored here for signature verification.
// COUNTER: Monotonically increases each use. If server sees counter <= stored value,
// the credential was likely CLONED — authentication is rejected (FIDO2 anti-cloning).
model Authenticator {
  id           String   @id @default(cuid())
  userId       String
  // credentialID: base64url-encoded credential identifier from the authenticator.
  // Used to look up the right public key during authentication.
  credentialID String   @unique
  // publicKey: COSE-encoded public key (binary). Used to verify authentication signatures.
  publicKey    Bytes
  // counter: monotonically increasing signature counter. Incremented by the authenticator
  // on every use. Allows server to detect cloned authenticators (cloning attack).
  counter      BigInt
  // deviceType: "platform" = built-in (Touch ID, Face ID, Windows Hello)
  //             "cross-platform" = external (YubiKey, security key)
  deviceType   String
  // backedUp: true if the passkey is synced to iCloud Keychain, Google Password Manager,
  //           etc. Backed-up passkeys can be restored if the device is lost.
  backedUp     Boolean
  // transports: JSON array of transport mechanisms (e.g., ["internal"], ["usb", "nfc"])
  //             Used to filter authenticators during authentication ceremony.
  transports   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
